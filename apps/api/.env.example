# إعدادات الخادم — انسخ الملف إلى .env وعدّل ما يلزم.
# كل المتغيّرات تبدأ بـ EDU_

# مفتاح توقيع الجلسات وبذور مفاتيح Ed25519 (إلزامي في الإنتاج).
EDU_SECRET_KEY=change-me-to-a-long-random-string

# قاعدة البيانات: SQLite في التطوير، Postgres في الإنتاج.
EDU_DATABASE_URL=sqlite:///data/app.db
# EDU_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/edu

# مجلد التخزين المحلي (في الإنتاج يُستبدل بـ R2 بنفس واجهة Storage).
EDU_STORAGE_DIR=storage

# أصل الواجهة المسموح له بـ CORS.
EDU_WEB_ORIGIN=http://localhost:5173

# اجعلها true عند العمل على HTTPS (إنتاج).
EDU_COOKIE_SECURE=false

# مدة صلاحية روابط الملفات الموقّعة (ثانية).
EDU_SIGNED_URL_TTL_SECONDS=900

# أقصى حجم رفع/استيراد (بايت) — 2 GiB.
EDU_MAX_UPLOAD_BYTES=2147483648
